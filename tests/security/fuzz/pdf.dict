# libFuzzer dictionary for PDF mutation. Tokens that appear here
# are spliced into inputs at higher probability, accelerating
# coverage of the structural paths that ad-hoc bitflips would
# otherwise miss. AFL++ -x flag accepts the same format.
#
# Source: PDF 1.7 spec keywords + PDFE attack-surface keywords
# (the same ones tested by tests/security/corpus/manifest.json).

# --- File structure
"%PDF-1.4"
"%PDF-1.5"
"%PDF-1.6"
"%PDF-1.7"
"%PDF-2.0"
"%%EOF"
"xref"
"startxref"
"trailer"
"obj"
"endobj"
"stream"
"endstream"
"<<"
">>"

# --- Object types
"/Type"
"/Subtype"
"/Catalog"
"/Pages"
"/Page"
"/Kids"
"/Count"
"/MediaBox"
"/CropBox"
"/Resources"
"/Contents"
"/Parent"
"/Length"
"/Filter"
"/N"
"/Linearized"

# --- Filters / encodings
"/FlateDecode"
"/ASCIIHexDecode"
"/ASCII85Decode"
"/LZWDecode"
"/RunLengthDecode"
"/CCITTFaxDecode"
"/JBIG2Decode"
"/DCTDecode"
"/JPXDecode"
"/Crypt"
"/Predictor"

# --- Names / strings
"/Name"
"/Title"
"/Author"
"/Subject"
"/Keywords"
"/Creator"
"/Producer"
"/CreationDate"
"/ModDate"

# --- Fonts
"/Font"
"/Type0"
"/Type1"
"/Type3"
"/TrueType"
"/CIDFontType0"
"/CIDFontType2"
"/Encoding"
"/WinAnsiEncoding"
"/MacRomanEncoding"
"/Identity-H"
"/Identity-V"
"/ToUnicode"
"/CIDToGIDMap"
"/FontDescriptor"
"/FontFile"
"/FontFile2"
"/FontFile3"
"/Widths"
"/W"
"/DW"

# --- Images / XObjects
"/XObject"
"/Image"
"/Form"
"/Width"
"/Height"
"/ColorSpace"
"/DeviceRGB"
"/DeviceGray"
"/DeviceCMYK"
"/ICCBased"
"/Indexed"
"/Pattern"
"/BitsPerComponent"

# --- Annotations / Forms (PDFE attack surface)
"/Annot"
"/Annots"
"/Action"
"/A"
"/JS"
"/JavaScript"
"/Launch"
"/SubmitForm"
"/ResetForm"
"/ImportData"
"/URI"
"/GoTo"
"/GoToR"
"/GoToE"
"/Named"
"/Trans"
"/F"
"/Win"
"/Mac"
"/Unix"
"/AcroForm"
"/Fields"
"/Tx"
"/Btn"
"/Ch"
"/Sig"
"/V"
"/DV"
"/Q"
"/MaxLen"
"/Opt"
"/TI"
"/T"

# --- XFA / forms
"/XFA"
"/NeedsRendering"
"/CalculationOrder"
"/CO"

# --- Linearization / streams
"/L"
"/H"
"/E"
"/O"
"/T"
"/P"
"/Linearized"

# --- Encryption
"/Encrypt"
"/U"
"/O"
"/P"
"/V"
"/R"
"/StmF"
"/StrF"
"/CF"
"/StdCF"
"/AESV2"
"/AESV3"
"/CFM"

# --- Embedded files / portfolios (attack surface)
"/EmbeddedFile"
"/EmbeddedFiles"
"/FileAttachment"
"/Filespec"
"/UF"
"/EF"
"/Names"
"/Dests"
"/Collection"

# --- Optional content / Layers
"/OCProperties"
"/OCG"
"/OCMD"
"/OFF"
"/ON"

# --- Tagged PDF (PDF/A, PDF/UA)
"/StructTreeRoot"
"/StructElem"
"/MarkInfo"
"/RoleMap"
"/ParentTree"
"/ParentTreeNextKey"
"/Marked"
"/Suspects"

# --- Common content-stream operators
"BT"
"ET"
"Tf"
"Tj"
"TJ"
"Td"
"TD"
"Tm"
"Tw"
"Tc"
"Tz"
"TL"
"Tr"
"q"
"Q"
"cm"
"re"
"S"
"f"
"f*"
"B"
"B*"
"n"
"W"
"W*"
"Do"
"BI"
"EI"
"ID"
