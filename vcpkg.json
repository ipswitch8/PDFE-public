{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "pdfe",
  "version-string": "0.1.0",
  "description": "Cross-platform PDF editor (Adobe Acrobat Pro-class)",
  "license": "AGPL-3.0-only",
  "builtin-baseline": "15e5f3820f0370f1ba7150853762cec0688cd396",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": true,
      "features": ["widgets"]
    },
    "qtsvg",
    "qttools",
    {
      "name": "libmupdf",
      "version>=": "1.26.10#1"
    },
    "qpdf",
    {
      "name": "gtest",
      "host": true
    },
    "freetype",
    "harfbuzz",
    "sqlite3",
    "tesseract",
    "pugixml",
    {
      "name": "curl",
      "platform": "!windows",
      "default-features": false,
      "features": ["openssl"]
    }
  ]
}
