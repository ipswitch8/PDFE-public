# Cloudflare R2 configuration for this runner.
#
# COPY THIS TO `.env` (same directory) AND FILL IT IN. `.env` is git-ignored;
# this template is not, and holds no secrets.
#
#     copy .env.example .env
#
# Set-R2Config.ps1 reads it, validates the values with a real PUT/GET/DELETE
# against the bucket, and only then writes them to the machine environment.
#
# It REFUSES to read a .env that git is not ignoring. That is not paranoia about
# this directory in particular: the blanket `.env` rule near the top of
# .gitignore does NOT reach here on its own, because the
# `!tools/runner-deployment/**` negation further down re-includes it and the
# last match wins. That hole was real and is now closed with an explicit
# re-ignore -- but the runtime check means the script is safe even if somebody
# copies it somewhere the rule does not apply.

# Cloudflare account id. The S3 endpoint is derived from it as
# https://<account id>.r2.cloudflarestorage.com
# Find it in the dashboard URL, or on the R2 overview page.
PDFE_R2_ACCOUNT_ID=

# Set this INSTEAD of the account id only if you need a non-default endpoint.
# It is the ACCOUNT host — do not append the bucket name; that produces 403s
# which read as a permissions problem.
#PDFE_R2_ENDPOINT=

PDFE_R2_BUCKET=pdfe-build-store

# From R2 -> Manage API Tokens -> Create API token. The token gives you an
# Access Key ID and a Secret Access Key (S3-compatible credentials).
#
# SCOPE IT TO THIS BUCKET, and give consume-only machines a READ-ONLY token.
# That is not a nicety: the commit marker inside the store travels in the same
# archive a writer controls, so it authenticates nothing against a party holding
# write credentials. Restricting who can write IS the integrity control.
PDFE_R2_ACCESS_KEY_ID=

# Optional. Leave BLANK to be prompted securely at run time, which keeps the
# secret out of both this file and shell history. Fill it in only if you are
# automating provisioning and have accepted that trade.
PDFE_R2_SECRET_ACCESS_KEY=
